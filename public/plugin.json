{
  "name": "CCSwitch",
  "version": "1.0.0",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "switch",
      "explain": "Claude Code 配置切换工具",
      "cmds": ["CCSwitch", "Claude配置切换", "切换Claude配置"]
    },
    {
      "code": "installSkill",
      "explain": "从 SkillHub 安装 Skill",
      "cmds": [
        {
          "type": "regex",
          "label": "安装 Skill",
          "match": "/^https://skillhub.tencent.com/skills/[\\w-]+$/",
          "minLength": 30,
          "maxLength": 200
        }
      ]
    }
  ]
}

{
  "name": "CCConfig",
  "version": "1.0.0",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "claudeConfig",
      "explain": "Claude Code 配置管理工具",
      "icon": "logo.png",
      "cmds": ["Claude Code配置"]
    },
    {
      "code": "opencodeConfig",
      "explain": "OpenCode 配置管理工具",
      "icon": "icon-opencode.png",
      "cmds": ["OpenCode配置"]
    },
    {
      "code": "piConfig",
      "explain": "Pi Agent 配置管理工具",
      "icon": "icon-pi.png",
      "cmds": ["Pi Agents配置"]
    },
    {
      "code": "ompConfig",
      "explain": "omp CLI 配置管理工具",
      "icon": "omp-icon.svg",
      "cmds": ["omp配置"]
    },
    {
      "code": "reasonixConfig",
      "explain": "Reasonix 配置管理工具",
      "icon": "reasonix.svg",
      "cmds": ["Reasonix配置"]
    },
    {
      "code": "commonConfig",
      "explain": "通用配置（跨 agent 主数据）",
      "icon": "gen.svg",
      "cmds": ["通用配置"]
    },
    {
      "code": "installClaudeSkill",
      "explain": "从 SkillHub/魔搭社区 安装 Claude Code Skill",
      "cmds": [
        {
          "type": "regex",
          "label": "安装 Claude Code Skill",
          "match": "/^https:\\/\\/(www\\.)?(skillhub\\.(tencent\\.com|cn)\\/skills\\/[\\w-]+|modelscope\\.cn\\/skills\\/@[\\w-]+\\/[\\w-]+)$/",
          "minLength": 30,
          "maxLength": 200
        }
      ]
    },
    {
      "code": "installOpencodeSkill",
      "explain": "从 SkillHub/魔搭社区 安装 OpenCode Skill",
      "icon": "icon-opencode.png",
      "cmds": [
        {
          "type": "regex",
          "label": "安装 OpenCode Skill",
          "match": "/^https:\\/\\/(www\\.)?(skillhub\\.(tencent\\.com|cn)\\/skills\\/[\\w-]+|modelscope\\.cn\\/skills\\/@[\\w-]+\\/[\\w-]+)$/",
          "minLength": 30,
          "maxLength": 200
        }
      ]
    },
    {
      "code": "installPiExtension",
      "explain": "安装 Pi Agent 扩展",
      "icon": "icon-pi.png",
      "cmds": [
        {
          "type": "regex",
          "label": "安装 Pi Agent 扩展",
          "match": "/^pi\\s+install\\s+.+/",
          "minLength": 12,
          "maxLength": 200
        }
      ]
    }
  ]
}
